{
  "name": "@react-native-ohos/react-native-version-number",
  "version": "0.5.0-beta.1",
  "description": "Access app version inside React Native",
  "main": "index.js",
  "homepage": "https://github.com/react-native-oh-library/react-native-version-number#readme",
  "repository": "https://github.com/react-native-oh-library/react-native-version-number",
  "scripts": {
    "lint": "eslint index.js",
    "test": "npm run lint",
    "codegen-lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name react-native-version-number --cpp-output-path ./harmony/rnoh_version_number/src/main/cpp/generated --ets-output-path ./harmony/rnoh_version_number/src/main/ets/generated --turbo-modules-spec-paths ./src/NativeRNVersionNumber.ts"
  },
  "tags": [
    "react",
    "react-native",
    "react-component",
    "harmony"
  ],
  "keywords": [
    "react",
    "react-native",
    "react-component",
    "harmony"
  ],
  "license": "MIT",
  "devDependencies": {
    "babel-eslint": "^6.1.2",
    "eslint": "^3.3.1",
    "eslint-plugin-react": "^6.1.2",
    "react-native-version-number": "0.3.6",
    "react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@^0.82.7"
  },
  "harmony": {
    "alias": "react-native-version-number",
    "autolinking": {
      "etsPackageClassName":"VersionNumberPackage",
      "cppPackageClassName":"VersionNumberPackage",
      "cmakeLibraryTargetName": "rnoh_version_number", 
      "ohPackageName": "@react-native-ohos/react-native-version-number"
    } 
  }
}
